# Optional Wise payment / invoice URL (leave empty until live)
VITE_WISE_PAYMENT_URL=
# Cal.com booking link
VITE_CAL_BOOKING_URL=https://app.cal.com/fourcee/30min
# Build base path: / for fourcee.lutho.app, /fourcee/ for ops preview
# FOURCEE_BASE=/

# --- Melissa chat proxy (server/chat-proxy.mjs) - SERVER-SIDE ONLY, never VITE_-prefixed, never in the browser bundle ---
