# CHAT_RATE_PER_MIN=12  CHAT_RATE_PER_DAY=150  CHAT_MAX_INFLIGHT=8  CHAT_FIRST_BYTE_MS=9000  CHAT_TOTAL_MS=45000  CHAT_TRUST_PROXY=1
